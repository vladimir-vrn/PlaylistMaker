<resources>
    <style name="SettingsToolbar" parent="Toolbar">
        <item name="titleTextColor">@color/yp_white</item>
        <item name="navigationIconTint">@color/yp_white</item>
    </style>
    <style name="SettingsItem" parent="SettingsItemGeneral">
        <item name="drawableTint">@color/yp_white</item>
        <item name="android:textColor">@color/yp_white</item>
    </style>q
    <style name="SearchToolbar" parent="Toolbar">
        <item name="titleTextColor">@color/yp_white</item>
        <item name="navigationIconTint">@color/yp_white</item>
    </style>
    <style name="SearchColor">
        <item name="android:drawableTint">@color/yp_black</item>
        <item name="android:textColor">@color/yp_black</item>
        <item name="android:textColorHint">@color/yp_black</item>
        <item name="tint">@color/yp_black</item>
    </style>
    <style name="MediaLibraryToolbar" parent="Toolbar">
        <item name="titleTextColor">@color/yp_white</item>
        <item name="navigationIconTint">@color/yp_white</item>
    </style>
    <style name="TrackColor" parent="TrackColorGeneral">
        <item name="android:textColor">@color/yp_white</item>
        <item name="drawableTint">@color/yp_white</item>
    </style>
    <style name="TrackColorName" parent="TrackColorGeneral">
        <item name="android:textColor">@color/yp_white</item>
        <item name="android:textSize">@dimen/other_text_size</item>
    </style>
    <style name="BtnPlaceholder" parent="BtnGeneral">
        <item name="android:backgroundTint">@color/yp_white</item>
        <item name="android:textColor">@color/yp_black</item>
    </style>
    <style name="TxtPlaceholder" parent="TxtPlaceholderGeneral">
        <item name="android:textColor">@color/yp_white</item>
    </style>
    <style name="PlayerToolbar" parent="Toolbar">
        <item name="contentInsetStartWithNavigation">64dp</item>
        <item name="navigationIcon">@drawable/ic_left_arrow</item>
        <item name="navigationIconTint">@color/yp_white</item>
    </style>
    <style name="PlayerTxtHeading" parent="PlayerTxtHeadingGeneral">
        <item name="android:textColor">@color/yp_white</item>
    </style>
    <style name="PlayerTxt" parent="PlayerTxtGeneral">
        <item name="android:textColor">@color/yp_white</item>
    </style>
    <style name="FavoritesTxt" parent="FavoritesTxtGeneral">
        <item name="android:textColor">@color/yp_white</item>
    </style>
    <style name="PlaylistsTxt" parent="PlaylistsTxtGeneral">
        <item name="android:textColor">@color/yp_white</item>
    </style>
    <style name="PlaylistsBtn" parent="BtnGeneral">
        <item name="android:backgroundTint">@color/yp_white</item>
        <item name="android:textColor">@color/yp_black</item>
    </style>
    <style name="PlaylistsBtnPlaylistCreated" parent="PlaylistsBtn">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginHorizontal">8dp</item>
        <item name="android:layout_marginBottom">@dimen/standard_indentation</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="cornerRadius">0dp</item>
    </style>
    <style name="MediaLibraryTabText" parent="MediaLibraryTabTextGeneral">
        <item name="android:textColor">@color/yp_white</item>
    </style>
    <style name="MediaLibraryTabLayout" parent="MediaLibraryTabLayoutGeneral">
        <item name="tabIndicatorColor">@color/yp_white</item>
    </style>
    <style name="RootBottomNavigationView" parent="RootBottomNavigationViewGeneral">
        <item name="android:background">@color/yp_black</item>
    </style>
    <style name="PlayListToolbar" parent="PlayListToolbarGeneral">
        <item name="navigationIconTint">@color/yp_white</item>
        <item name="titleTextColor">@color/yp_white</item>
    </style>
    <style name="PlayListTextInputLayout" parent="PlayListTextInputLayoutGeneral">
        <item name="hintTextColor">@color/yp_white</item>
        <item name="android:textColorHint">@color/yp_white</item>
        <item name="cursorColor">@color/yp_white</item>
    </style>
    <style name="PlayListTextInputEditText" parent="PlayListTextInputEditTextGeneral">
        <item name="android:textColor">@color/yp_white</item>
    </style>
    <style name="PlayListTextGrid" parent="PlayListTextGridGeneral">
        <item name="android:textColor">@color/yp_white</item>
    </style>
    <style name="PlayListTextName" parent="PlayListTextGeneral">
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:textSize">16sp</item>
    </style>
    <style name="PlayListTextNumberTracks" parent="PlayListTextGeneral">
        <item name="android:textSize">11sp</item>
    </style>
    <style name="BottomSheetBtn" parent="BtnGeneral">
        <item name="android:backgroundTint">@color/yp_white</item>
        <item name="android:textColor">@color/yp_black</item>
    </style>
    <style name="BottomSheetText" parent="BottomSheetTextGeneral">
        <item name="android:textColor">@color/yp_white</item>
    </style>
</resources>